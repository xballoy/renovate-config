{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:earlyMondays",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":automergeMinor",
    "customManagers:biomeVersions"
  ],
  "commitMessagePrefix": "build(deps):",
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "timezone": "America/Toronto",
  "constraints": {
    "ghActionsLock": "v0.4.1"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Minor and Patch Updates"
    },
    {
      "groupName": "gh-actions-lock",
      "matchDepNames": ["github/gh-actions-lock"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "gh-actions-lock extension installed by CI",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["gh extension install github/gh-actions-lock --pin (?<currentValue>v\\S+)"],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "gh-actions-lock extension Renovate uses to regenerate actions.lock",
      "managerFilePatterns": ["/^(default|renovate)\\.json$/"],
      "matchStrings": ["\"ghActionsLock\": \"(?<currentValue>v[^\"]+)\""],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ]
}
